{
  "version": 2,
  "buildCommand": "npm run build --prefix services/inventory-api",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "services/inventory-api/dist/services/inventory-api/src/server.js"
    }
  ],
  "functions": {
    "services/inventory-api/dist/services/inventory-api/src/server.js": {
      "maxDuration": 30
    }
  }
}
